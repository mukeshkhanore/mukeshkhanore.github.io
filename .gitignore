# GitHub Pages serves this repository directly, so anything ignored here is
# simply absent from the live site. Never paste build-output patterns from a
# generic Node .gitignore (dist/, build/, *.html): index.html and
# Assets/icons.svg are generated by `npm run build` and MUST stay committed.

# Dependencies — the only large thing that should never be committed.
# package-lock.json is deliberately NOT ignored; CI runs `npm ci` against it.
node_modules/

# Local tool state. Also covered by this machine's global git ignore, but
# repeated here so the rule travels with the repository.
.claude/settings.local.json

# Review output from scripts/cv_to_data.py — never commit these; adopt one by
# moving it over Assets/data.js after reading the diff.
Assets/data.generated.js
Assets/data_new.js

# The CV parser is a local authoring tool, not part of the build. The other
# four scripts/ files are required by package.json and CI and must stay
# committed — ignoring the folder makes every CI job fail on a missing file.
scripts/cv_to_data.py
__pycache__/
*.pyc

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs and local environment
*.log
npm-debug.log*
.env
.env.*
